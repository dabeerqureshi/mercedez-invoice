# ---- Runs with NOTHING set (mock prices + local SQLite + local file storage) ----

# Price source: "mock" (offline deterministic test prices) or "mercedes" (live)
NEXT_PUBLIC_PRICE_SOURCE=mock

# Which Mercedes price field to invoice: "list" | "net"
MERCEDES_PRICE_FIELD=list

# ---- Phase 2: persistence (Turso/libSQL) ----
# Leave blank to use a local file at .data/mercedes_invoice.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# ---- Phase 2: invoice file storage (Vercel Blob) ----
# Leave blank to store files under .data/ and serve via /api/files
BLOB_READ_WRITE_TOKEN=

# ---- Phase 2: email (SMTP) ----
# When unset, the invoice is still saved and the UI offers "Retry Email".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# ---- Phase 3: live Mercedes pricing via Browserbase ----
# Required when NEXT_PUBLIC_PRICE_SOURCE=mercedes:
#   https://www.browserbase.com/settings  -> API Keys / Project ID
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Optional tuning (defaults shown). Web defaults are shorter than the desktop
# app so one lookup always fits inside a serverless function run.
#MERCEDES_NAV_TIMEOUT_MS=25000
#MERCEDES_RESPONSE_TIMEOUT_MS=18000
#MERCEDES_LOOKUP_BUDGET_MS=50000
#MERCEDES_PART_SEARCH_SELECTOR=
#MERCEDES_RESET_CATALOG_BEFORE_SCAN=true
#MERCEDES_REMEMBER_ME=true

# ---- Phase 4: hardening ----
# Shared shop password for the deployed app. Unset = open access (desktop
# parity, zero-config local dev). When set, / asks for it and /login handles
# the session cookie; AUTH_SECRET optionally keys the cookie signature
# (defaults to the password itself).
APP_PASSWORD=
AUTH_SECRET=
# Guards /api/cron/keep-alive for Vercel Cron (sent as `Authorization: Bearer`)
# and external pingers (?secret=...). Also set CRON_SECRET in Vercel so the
# scheduler's request is accepted.
CRON_SECRET=
# Quiet Mercedes session refresh interval in seconds (0 disables). The open
# POS page pings at this cadence; Vercel Cron / external pingers cover idle time.
#MERCEDES_KEEP_ALIVE_S=240